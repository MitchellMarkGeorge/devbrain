---
import Layout from '../components/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import {  } from '@lucide/astro';
import GitHubMark from '../components/GitHubMark.astro';
import { formatDate, getReleases, REPOSITORY_URL } from '../lib/releases';

// The notes are written on each GitHub release (docs/releasing.md) and rendered by GitHub
const releases = await getReleases();
const latestId = releases.find((r) => !r.prerelease)?.version;
---

<Layout title="Changelog" description="What’s new in each version of DevBrain, the second brain for developers: new features, changes and fixes, from the release notes.">
  <PageHeader
    live={releases.length > 0}
    badge={releases.length > 0
      ? `${releases.length} ${releases.length === 1 ? 'release' : 'releases'}`
      : 'Coming soon'}
    title="Changelog"
    lede="What’s new in each version of DevBrain, newest first."
  />

  <section class="container page">
    {
      releases.length === 0 ? (
        <div class="empty spotlight" data-spotlight data-reveal>
          <h2>No releases yet</h2>
          <p class="muted">Each version’s notes will be here, from its release on GitHub.</p>
          <a class="button" href={REPOSITORY_URL}>
            <GitHubMark size={16} />
            Follow along on GitHub
          </a>
        </div>
      ) : (
        <ol class="timeline">
          {releases.map((release) => (
            <li id={`v${release.version}`} class="entry" data-reveal>
              <div class="when">
                <time datetime={release.publishedAt.toISOString()}>
                  {formatDate(release.publishedAt)}
                </time>
              </div>
              <span class="dot" aria-hidden="true" />
              <article class="spotlight" data-spotlight>
                <header>
                  <span class="version">v{release.version}</span>
                  {release.version === latestId && <span class="tag latest">Latest</span>}
                  {release.prerelease && <span class="tag">Pre-release</span>}
                </header>
                <h2>
                  <a href={release.url}>{release.name}</a>
                </h2>
                <div class="notes" set:html={release.notesHtml} />
              </article>
            </li>
          ))}
        </ol>
      )
    }
  </section>
</Layout>

<style>
  .page {
    max-width: 880px;
    margin-top: var(--space-12);
  }

  /*
   * The timeline: a line down the left, a dot at each release, its date beside the dot on wide
   * screens and above its card on narrow ones.
   */
  .timeline {
    position: relative;
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-8);
  }
  .timeline::before {
    content: '';
    position: absolute;
    top: var(--space-2);
    bottom: 0;
    left: 7px;
    width: 1px;
    background: linear-gradient(var(--border-strong) 80%, transparent);
  }
  .entry {
    position: relative;
    display: grid;
    grid-template-columns: 15px 1fr;
    column-gap: var(--space-6);
    row-gap: var(--space-2);
    scroll-margin-top: 96px;
  }
  .when {
    grid-column: 2;
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .dot {
    grid-column: 1;
    grid-row: 1;
    margin-top: 3px;
    width: 15px;
    height: 15px;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-strong);
    background: var(--background);
    box-shadow: inset 0 0 0 3px var(--background);
  }
  .entry:first-child .dot {
    background: var(--foreground-strong);
    box-shadow:
      inset 0 0 0 3px var(--background),
      0 0 0 4px color-mix(in srgb, var(--foreground-strong) 12%, transparent);
  }
  .entry article {
    grid-column: 2;
    padding: var(--space-6);
  }
  @media (min-width: 720px) {
    .timeline::before {
      left: calc(140px + var(--space-6) + 7px);
    }
    .entry {
      grid-template-columns: 140px 15px 1fr;
    }
    .when {
      grid-column: 1;
      grid-row: 1;
      padding-top: 2px;
      text-align: right;
    }
    .dot {
      grid-column: 2;
    }
    .entry article {
      grid-column: 3;
      grid-row: 1;
    }
  }

  header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }
  .version {
    color: var(--foreground-strong);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .tag {
    padding: 0 var(--space-2);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-full);
    color: var(--muted-foreground);
    font-size: var(--text-xs);
    line-height: 20px;
  }
  .tag.latest {
    border-color: color-mix(in srgb, var(--status-completed) 40%, transparent);
    color: var(--status-completed);
  }
  h2 {
    margin-top: var(--space-2);
    font-size: var(--text-xl);
    line-height: var(--text-xl-leading);
    font-weight: var(--font-weight-semibold);
  }
  h2 a {
    color: var(--foreground-strong);
    text-decoration: none;
  }
  h2 a:hover {
    text-decoration: underline;
  }
  .notes {
    margin-top: var(--space-3);
    color: var(--foreground);
    font-size: var(--text-sm);
    line-height: 1.7;
  }
  .notes :global(:is(p, ul, ol, pre)) {
    margin-top: var(--space-3);
  }
  .notes :global(:is(ul, ol)) {
    padding-left: var(--space-6);
  }
  .notes :global(:is(h2, h3)) {
    margin-top: var(--space-6);
    color: var(--foreground-strong);
    font-size: var(--text-base);
    font-weight: var(--font-weight-medium);
  }
  .notes :global(code) {
    padding: 1px 4px;
    border-radius: var(--radius-xs);
    background: var(--secondary);
  }
  .notes :global(pre) {
    overflow-x: auto;
    padding: var(--space-3);
    border-radius: var(--radius-lg);
    background: var(--background);
  }
  .notes :global(pre code) {
    padding: 0;
    background: none;
  }

  .empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-12) var(--space-6);
    text-align: center;
  }
  .empty h2 {
    margin: 0;
    color: var(--foreground-strong);
    font-size: var(--text-2xl);
    line-height: var(--text-2xl-leading);
  }
  .empty .button {
    margin-top: var(--space-3);
  }
</style>
