---
/**
 * Replaces Starlight's SiteTitle in the docs' header: the app's logomark drawn inline, as the
 * marketing pages' header draws it (Layout.astro), then the site's name.
 *
 * Starlight's own draws the logo as an image, which the browser fetches again on each page when
 * it isn't cached (always, on the dev server), so the header flashed without it on navigation.
 * Inline, it's part of the page, and one copy follows the theme through its fill.
 */
import logomark from '../../../src/renderer/assets/devbrain-logomark.svg?raw';

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex">
  <span class="logomark" aria-hidden="true" set:html={logomark} />
  <span class="name" translate="no">{siteTitle}</span>
</a>

<style>
  .site-title {
    align-items: center;
    gap: var(--sl-nav-gap);
    font-size: var(--sl-text-h4);
    font-weight: 600;
    color: var(--sl-color-text-accent);
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
  }
  .name {
    overflow: hidden;
  }
  /* at the app's sidebar size, not Starlight's full nav height */
  .logomark {
    display: flex;
    flex-shrink: 0;
  }
  .logomark :global(svg) {
    width: 1.25rem;
    height: 1.5rem;
  }
  /* the logomark is drawn in white for dark; light draws it in the foreground */
  .logomark :global(g) {
    fill: var(--foreground-strong);
  }
</style>
