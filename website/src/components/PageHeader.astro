---
/**
 * The top of a page other than the home page (download, changelog): the home hero's light and grid
 * at a smaller scale, a badge, a title that rises in word by word, and a line under it. The slot
 * goes under the line (a link, a button).
 */
interface Props {
  badge: string;
  // the badge's green dot, for something available now (not "Coming soon")
  live?: boolean;
  title: string;
  lede?: string;
}

const { badge, live = true, title, lede } = Astro.props;
---

<header class="page-header">
  <div class="grid-backdrop"></div>
  <div class="container inner">
    <span class="badge" data-reveal>{live && <span class="dot" />}{badge}</span>
    <h1 aria-label={title}>
      {
        title.split(' ').map((word, i) => (
          <span class="word" style={`--i: ${i}`} aria-hidden="true">
            {word}{' '}
          </span>
        ))
      }
    </h1>
    {
      lede && (
        <p class="lede" data-reveal style="--delay: 200ms">
          {lede}
        </p>
      )
    }
    <div data-reveal style="--delay: 300ms"><slot /></div>
  </div>
</header>

<style>
  .page-header {
    position: relative;
    isolation: isolate;
    padding-top: var(--space-16);
    text-align: center;
  }
  /* a smaller version of the home hero's light (index.astro) */
  .page-header::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -120px 0 auto;
    height: 520px;
    pointer-events: none;
    background:
      radial-gradient(ellipse 35% 50% at 50% 0%, var(--swatch-indigo-tint), transparent 70%),
      radial-gradient(ellipse 22% 35% at 35% 10%, var(--swatch-blue-tint), transparent 70%),
      radial-gradient(ellipse 22% 35% at 65% 10%, var(--swatch-pink-tint), transparent 70%);
    filter: blur(20px);
  }
  .inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  h1 {
    margin-top: var(--space-6);
    font-size: clamp(36px, 6vw, 56px);
    line-height: 1.05;
    font-weight: var(--font-weight-semibold);
    letter-spacing: -0.035em;
  }
  /*
   * Each word carries the gradient itself (.gradient-text), not the heading: Chromium leaves a
   * child that animates a transform or filter out of its parent's background-clip: text, so a
   * gradient on the heading hides its words as they rise in.
   */
  .word {
    display: inline-block;
    white-space: pre;
    background: linear-gradient(180deg, var(--foreground-strong) 30%, var(--muted-foreground));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .word {
      animation: word-in 0.8s var(--ease-out) both;
      animation-delay: calc(var(--i) * 60ms + 100ms);
    }
  }
  @keyframes word-in {
    from {
      opacity: 0;
      transform: translateY(0.4em);
      filter: blur(8px);
    }
  }
  .lede {
    max-width: 56ch;
    margin-top: var(--space-4);
    color: var(--muted-foreground);
    font-size: var(--text-lg);
    line-height: var(--text-lg-leading);
  }
  .lede + div:not(:empty) {
    margin-top: var(--space-4);
  }
</style>
