---
/**
 * A screenshot of the app in the docs: the dark or light capture of `page` from
 * src/assets/screenshots (made by `npm run website:screenshots`, website/README.md), resized and
 * converted to WebP at build time, with a caption.
 *
 * Where Screenshot.astro (the home page) follows the system's colour scheme, the docs have
 * Starlight's theme picker: both captures are in the page, and the one for the theme on <html
 * data-theme> is shown. The other is never downloaded (a lazy image that isn't drawn isn't loaded).
 *
 * On a phone the whole window would be too small to read, so it shows a crop at twice the size,
 * half the window's width starting `focusX` of the way across (0 is the left edge, 1 the right),
 * and the image links to the full capture.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  // the capture's name, as in PAGES in e2e/screenshots/website.screens.ts
  page: string;
  alt: string;
  caption?: string;
  // where a phone's crop starts, as a fraction of the window's width
  focusX?: number;
}

const { page, alt, caption, focusX = 0 } = Astro.props;
const captures = import.meta.glob<{ default: ImageMetadata }>('../assets/screenshots/*.png', {
  eager: true,
});
const capture = (theme: 'dark' | 'light') => {
  const image = captures[`../assets/screenshots/${page}-${theme}.png`];
  if (!image) throw new Error(`No ${theme} screenshot of ${page}: run npm run website:screenshots`);
  return image.default;
};

// the docs' content column is at most about 720px wide; on a phone the crop is twice the screen
const sizes = '(max-width: 639px) 200vw, 720px';
const widths = [720, 1080, 1440, 2160];
const images = await Promise.all(
  (['dark', 'light'] as const).map(async (theme) => ({
    theme,
    image: await getImage({ src: capture(theme), widths, format: 'webp' }),
  })),
);
---

<figure class="docs-screenshot not-content" style={`--focus-x: ${focusX}`}>
  {
    images.map(({ theme, image }) => (
      <a class="frame" data-theme-image={theme} href={image.src}>
        <img
          src={image.src}
          srcset={image.srcSet.attribute}
          sizes={sizes}
          alt={alt}
          width={image.attributes.width}
          height={image.attributes.height}
          loading="lazy"
          decoding="async"
        />
      </a>
    ))
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .docs-screenshot {
    margin-block: 1.5rem;
  }
  .frame {
    display: block;
    overflow: hidden;
    border: 1px solid var(--edge);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }
  .frame img {
    display: block;
    width: 100%;
    height: auto;
  }
  figcaption {
    margin-top: 0.5rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }

  /* the capture for the theme Starlight's picker resolved to */
  :global([data-theme='dark']) .frame[data-theme-image='light'],
  :global([data-theme='light']) .frame[data-theme-image='dark'] {
    display: none;
  }

  /* Phones: half the window, at twice the size, in a 4:3 frame */
  @media (max-width: 639px) {
    .frame {
      aspect-ratio: 4 / 3;
    }
    .frame img {
      width: 200%;
      max-width: none;
      /* --focus-x of the image's width, which is twice the frame's */
      margin-left: calc(var(--focus-x) * -200%);
    }
  }
</style>
