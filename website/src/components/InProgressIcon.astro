---
/**
 * The app's in-progress glyph (`CoreCircle` in src/renderer/components/entities/StatusIcon): a
 * circle at the icon stroke with a solid core, in currentColor. A copy: change both together.
 */
interface Props {
  size?: number;
}
const { size = 16 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true">
  <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="1.75"></circle>
  <circle cx="12" cy="12" r="4.5" fill="currentColor"></circle>
</svg>
