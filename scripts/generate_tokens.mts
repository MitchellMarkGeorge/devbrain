import { readFileSync, writeFileSync } from 'node:fs';

/**
 * Writes src/renderer/styles/tokens.css from docs/design-system/tokens.json, the token source
 * shared with the published design system page. Run with `npm run tokens`.
 */

type Themed = string | { dark: string; light?: string };
interface Token {
  name: string;
  value: Themed;
  usage: string;
}
interface Tokens {
  color: { tokens: Token[] };
  type: { families: Record<string, string> };
  spacing: { tokens: Token[] };
  radius: { tokens: Token[] };
  shadow: { tokens: Token[] };
  size: { tokens: Token[] };
  zIndex: { tokens: Token[] };
}

const SOURCE = 'docs/design-system/tokens.json';
const OUTPUT = 'src/renderer/styles/tokens.css';
const WINDOW_OUTPUT = 'src/common/theme.ts';
const DOMAIN = /^(status|priority|health|date|now|swatch)-/;

const tokens = JSON.parse(readFileSync(SOURCE, 'utf8')) as Tokens;

function resolve(value: Themed, theme: 'dark' | 'light'): string {
  const raw = typeof value === 'string' ? value : (value[theme] ?? value.dark);
  const alias = /^\{(.+)\}$/.exec(raw);
  return alias ? `var(--${alias[1]})` : raw;
}

/** A short note on how a dark token differs from shadcn's neutral theme, from its usage note. */
function override(usage: string): string {
  const note = usage.replace(/`/g, '');
  if (/DevBrain addition/.test(note)) return ' /* DevBrain addition */';
  const shadcn = /shadcn(?: uses)? ([^;:,.)]+)/.exec(note.slice(note.indexOf('DevBrain')));
  if (!/DevBrain (dark )?override/.test(note) || !shadcn) return '';
  return ` /* overrides shadcn ${shadcn[1].trim()} */`;
}

const palette = tokens.color.tokens.filter(
  (t) => typeof t.value === 'string' && t.value.startsWith('#'),
);
const rest = tokens.color.tokens.filter((t) => !palette.includes(t));
const domain = rest.filter((t) => DOMAIN.test(t.name));
const theme = rest.filter((t) => !DOMAIN.test(t.name));

const lines: string[] = [
  `/*
 * DevBrain design tokens. GENERATED by scripts/generate_tokens.mts from ${SOURCE}:
 * edit the JSON and run \`npm run tokens\`.
 *
 * DevBrain uses shadcn/ui components drawn in the DevBrain Figma file's design language.
 * Colour variables use shadcn's names (--background, --primary, --muted-foreground, ...) so
 * shadcn components keep their meaning; the app styles them with CSS Modules, not Tailwind.
 *
 * Dark is the first theme. The light theme (shadcn's neutral light theme) applies when
 * prefers-color-scheme is light, which the app sets from its theme setting. Every colour is a
 * Tailwind v4 colour.
 *
 *   1. Palette  --neutral-*, --red-*, ...    raw Tailwind steps; components never use these
 *   2. Theme    --background, --primary, ... shadcn's variables, per theme
 *   3. Domain   --status-*, --priority-*, --swatch-*: DevBrain meanings
 *
 * See docs/design-system/README.md.
 */`,
  '',
  ':root {',
  '  /* 1. Palette: Tailwind v4, hex of its oklch values */',
  ...palette.map((t) => `  --${t.name}: ${t.value as string};`),
  '',
  '  /* Typography */',
  ...Object.entries(tokens.type.families).map(([key, stack]) => `  --font-${key}: ${stack};`),
  ...(
    [
      ['xs', 12, 16],
      ['sm', 14, 20],
      ['base', 16, 24],
      ['lg', 18, 28],
      ['xl', 20, 28],
      ['2xl', 24, 32],
      ['3xl', 30, 36],
    ] as const
  ).flatMap(([name, size, leading]) => [
    `  --text-${name}: ${size}px;`,
    `  --text-${name}-leading: ${leading}px;`,
  ]),
  '  --font-weight-normal: 400;',
  '  --font-weight-medium: 500;',
  '  --font-weight-semibold: 600;',
  '  --tracking-tight: -0.025em;',
  '  --tracking-widest: 0.1em;',
];

for (const [family, title] of [
  ['spacing', 'Spacing'],
  ['radius', 'Radius'],
  ['shadow', 'Shadows'],
  ['size', 'Sizes'],
  ['zIndex', 'Layers'],
] as const) {
  lines.push('', `  /* ${title} */`);
  for (const t of tokens[family].tokens) lines.push(`  --${t.name}: ${resolve(t.value, 'dark')};`);
}

lines.push(
  '',
  '  /* Motion */',
  '  --duration-fast: 100ms; /* hover, press */',
  '  --duration-normal: 150ms; /* menus, popovers, tooltips */',
  '  --duration-slow: 250ms; /* dialogs, sheets, toasts */',
  '  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);',
  '',
  '  /* 3. Domain colours that do not change with the theme */',
  ...domain
    .filter((t) => typeof t.value === 'string')
    .map((t) => `  --${t.name}: ${resolve(t.value, 'dark')};`),
  "  --platform-linear: #5e6ad2; /* Linear's brand colour, the one non-Tailwind value */",
  '  --platform-github: var(--neutral-200);',
  '}',
);

// one theme's variables, indented by `indent`
function themeBlock(name: 'dark' | 'light', selector: string, indent = ''): string[] {
  const block = [`${selector} {`, `  color-scheme: ${name};`];
  for (const t of theme) {
    block.push(
      `  --${t.name}: ${resolve(t.value, name)};${name === 'dark' ? override(t.usage) : ''}`,
    );
  }
  block.push('');
  for (const t of domain.filter((d) => typeof d.value !== 'string')) {
    block.push(`  --${t.name}: ${resolve(t.value, name)};`);
  }
  block.push('}');
  return block.map((line) => (line === '' ? line : indent + line));
}

// The app sets Electron's nativeTheme.themeSource from the theme setting, which decides what
// prefers-color-scheme reports, so the page follows the setting from its first paint.
lines.push(
  '',
  '/* 2. Theme: dark, the default */',
  ...themeBlock('dark', ':root'),
  '',
  "/* 2. Theme: light, when the system (or the app's theme setting) asks for it */",
  '@media (prefers-color-scheme: light) {',
  ...themeBlock('light', ':root', '  '),
  '}',
);

lines.push(
  '',
  '@media (prefers-reduced-motion: reduce) {',
  '  :root {',
  '    --duration-fast: 0ms;',
  '    --duration-normal: 0ms;',
  '    --duration-slow: 0ms;',
  '  }',
  '}',
  '',
);

writeFileSync(OUTPUT, lines.join('\n'));
console.log(`Wrote ${OUTPUT}`);

// The window's background in each theme, as hex: the main process paints it before the page loads
const hexes = new Map(palette.map((t) => [t.name, t.value as string]));
function hex(name: string, themeName: 'dark' | 'light'): string {
  const token = tokens.color.tokens.find((t) => t.name === name);
  if (!token) throw new Error(`No colour token ${name}`);
  const raw =
    typeof token.value === 'string' ? token.value : (token.value[themeName] ?? token.value.dark);
  const alias = /^\{(.+)\}$/.exec(raw);
  const value = alias ? hexes.get(alias[1]) : raw;
  if (!value?.startsWith('#')) throw new Error(`${name} is not a palette colour in ${themeName}`);
  return value;
}

writeFileSync(
  WINDOW_OUTPUT,
  `// GENERATED by scripts/generate_tokens.mts from ${SOURCE}:
// edit the JSON and run \`npm run tokens\`.

// --background in each theme, which the window shows before the page has painted
export const WINDOW_BACKGROUND = {
  dark: '${hex('background', 'dark')}',
  light: '${hex('background', 'light')}',
} as const;
`,
);
console.log(`Wrote ${WINDOW_OUTPUT}`);
