import { readFileSync, writeFileSync } from 'node:fs';

/**
 * Writes src/renderer/styles/tokens.css from docs/design-system/tokens.json, the token source
 * shared with the published design system page. Run with `npm run tokens`.
 */

type Themed = string | { dark: string; light?: string };
interface Token {
  name: string;
  value: Themed;
  usage: string;
}
interface Tokens {
  color: { tokens: Token[] };
  type: { families: Record<string, string> };
  spacing: { tokens: Token[] };
  radius: { tokens: Token[] };
  shadow: { tokens: Token[] };
  size: { tokens: Token[] };
  zIndex: { tokens: Token[] };
}

const SOURCE = 'docs/design-system/tokens.json';
const OUTPUT = 'src/renderer/styles/tokens.css';
const DOMAIN = /^(status|priority|health|date|now|swatch)-/;

const tokens = JSON.parse(readFileSync(SOURCE, 'utf8')) as Tokens;

function resolve(value: Themed, theme: 'dark' | 'light'): string {
  const raw = typeof value === 'string' ? value : (value[theme] ?? value.dark);
  const alias = /^\{(.+)\}$/.exec(raw);
  return alias ? `var(--${alias[1]})` : raw;
}

/** A short note on how a dark token differs from shadcn's neutral theme, from its usage note. */
function override(usage: string): string {
  const note = usage.replace(/`/g, '');
  if (/DevBrain addition/.test(note)) return ' /* DevBrain addition */';
  const shadcn = /shadcn(?: uses)? ([^;:,.)]+)/.exec(note.slice(note.indexOf('DevBrain')));
  if (!/DevBrain (dark )?override/.test(note) || !shadcn) return '';
  return ` /* overrides shadcn ${shadcn[1].trim()} */`;
}

const palette = tokens.color.tokens.filter(
  (t) => typeof t.value === 'string' && t.value.startsWith('#'),
);
const rest = tokens.color.tokens.filter((t) => !palette.includes(t));
const domain = rest.filter((t) => DOMAIN.test(t.name));
const theme = rest.filter((t) => !DOMAIN.test(t.name));

const lines: string[] = [
  `/*
 * DevBrain design tokens. GENERATED by scripts/generate_tokens.mts from ${SOURCE}:
 * edit the JSON and run \`npm run tokens\`.
 *
 * DevBrain is built on shadcn/ui (new-york-v4). Colour variables use shadcn's names
 * (--background, --primary, --muted-foreground, --sidebar-accent, ...) so shadcn components
 * keep their meaning; the app styles them with CSS Modules instead of Tailwind.
 *
 * Dark is the first theme (no data-theme, or data-theme="dark"); data-theme="light" on <html>
 * switches to shadcn's neutral light theme. Every colour is a Tailwind v4 colour.
 *
 *   1. Palette  --neutral-*, --red-*, ...    raw Tailwind steps; components never use these
 *   2. Theme    --background, --primary, ... shadcn's variables, per theme
 *   3. Domain   --status-*, --priority-*, --swatch-*: DevBrain meanings
 *
 * See docs/design-system/README.md.
 */`,
  '',
  ':root {',
  '  /* 1. Palette: Tailwind v4, hex of its oklch values */',
  ...palette.map((t) => `  --${t.name}: ${t.value as string};`),
  '',
  '  /* Typography */',
  ...Object.entries(tokens.type.families).map(([key, stack]) => `  --font-${key}: ${stack};`),
  ...(
    [
      ['xs', 12, 16],
      ['sm', 14, 20],
      ['base', 16, 24],
      ['lg', 18, 28],
      ['xl', 20, 28],
      ['2xl', 24, 32],
      ['3xl', 30, 36],
    ] as const
  ).flatMap(([name, size, leading]) => [
    `  --text-${name}: ${size}px;`,
    `  --text-${name}-leading: ${leading}px;`,
  ]),
  '  --font-weight-normal: 400;',
  '  --font-weight-medium: 500;',
  '  --font-weight-semibold: 600;',
  '  --tracking-tight: -0.025em;',
  '  --tracking-widest: 0.1em;',
];

for (const [family, title] of [
  ['spacing', 'Spacing'],
  ['radius', 'Radius: shadcn scale derived from --radius'],
  ['shadow', 'Shadows: Tailwind v4'],
  ['size', 'Sizes: shadcn component heights and widths'],
  ['zIndex', 'Layers'],
] as const) {
  lines.push('', `  /* ${title} */`);
  for (const t of tokens[family].tokens) lines.push(`  --${t.name}: ${resolve(t.value, 'dark')};`);
}

lines.push(
  '',
  '  /* Motion: shadcn / tw-animate-css */',
  '  --duration-fast: 150ms;',
  '  --duration-normal: 200ms;',
  '  --duration-sheet-in: 500ms;',
  '  --duration-sheet-out: 300ms;',
  '',
  '  /* 3. Domain colours that do not change with the theme */',
  ...domain
    .filter((t) => typeof t.value === 'string')
    .map((t) => `  --${t.name}: ${resolve(t.value, 'dark')};`),
  "  --platform-linear: #5e6ad2; /* Linear's brand colour, the one non-Tailwind value */",
  '  --platform-github: var(--neutral-200);',
  '}',
);

for (const [name, selector] of [
  ['dark', ":root,\n:root[data-theme='dark']"],
  ['light', ":root[data-theme='light']"],
] as const) {
  lines.push('', `/* 2. Theme: ${name} */`, `${selector} {`, `  color-scheme: ${name};`);
  for (const t of theme) {
    lines.push(
      `  --${t.name}: ${resolve(t.value, name)};${name === 'dark' ? override(t.usage) : ''}`,
    );
  }
  lines.push('');
  for (const t of domain.filter((d) => typeof d.value !== 'string')) {
    lines.push(`  --${t.name}: ${resolve(t.value, name)};`);
  }
  lines.push('}');
}

lines.push(
  '',
  '@media (prefers-reduced-motion: reduce) {',
  '  :root {',
  '    --duration-fast: 0ms;',
  '    --duration-normal: 0ms;',
  '    --duration-sheet-in: 0ms;',
  '    --duration-sheet-out: 0ms;',
  '  }',
  '}',
  '',
);

writeFileSync(OUTPUT, lines.join('\n'));
console.log(`Wrote ${OUTPUT}`);
