{
  "compilerOptions": {
    // typecheck only
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@common/*": ["./src/common/*"],
      // types only: the renderer imports `type AppRouter` from main; ESLint rejects a value import
      "@main/*": ["./src/main/*"]
    }
  },
  "include": [
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    "src/common/**/*.ts",
    "vite/renderer.config.ts"
  ]
}
